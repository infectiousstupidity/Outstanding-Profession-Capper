<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="Core.lua"/>

  <Frame name="MainFrameCore" parent="UIParent" hidden="true" movable="true" enableMouse="true" clampedToScreen="true">
    <Scripts>
      <OnLoad>fnOnLoad(); self:SetBackdropColor(0.035, 0.035, 0.035, 0.97); self:SetBackdropBorderColor(0.28, 0.28, 0.28, 1);</OnLoad>
      <OnEvent>fnOnEvent();</OnEvent>
      <OnDragStart>ProfessionCapper_OnDragStart();</OnDragStart>
      <OnDragStop>ProfessionCapper_OnDragStop();</OnDragStop>
    </Scripts>

    <Size><AbsDimension x="390" y="413"/></Size>

    <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
      <TileSize><AbsValue val="16"/></TileSize>
      <EdgeSize><AbsValue val="16"/></EdgeSize>
      <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4"/></BackgroundInsets>
    </Backdrop>

    <Layers>
      <Layer level="ARTWORK">
        <FontString name="txtHeaderLabel" inherits="GameFontNormalLarge" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-16"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtProfessionProgress" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size><AbsDimension x="320" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-75"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <Texture name="imgSkillIcon" file="Interface\InventoryItems\WoWUnknownItem01">
          <Size><AbsDimension x="44" y="44"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-104"/></Offset></Anchor>
          </Anchors>
        </Texture>

        <FontString name="txtShouldCraft" inherits="GameFontNormal" justifyH="LEFT">
          <Size><AbsDimension x="288" y="20"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="76" y="-102"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtTarget" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size><AbsDimension x="288" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="76" y="-125"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtRecipeStatus" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size><AbsDimension x="288" y="34"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="76" y="-147"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCraftStats" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size><AbsDimension x="354" y="20"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-186"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCraftProgress" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size><AbsDimension x="354" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-210"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCraftEta" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size><AbsDimension x="354" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-232"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCostSummary" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size><AbsDimension x="354" y="38"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-254"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtMaterialsLabel" inherits="GameFontNormal" justifyH="LEFT" text="Materials">
          <Size><AbsDimension x="354" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-294"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtRepeatLabel" inherits="GameFontHighlightSmall" justifyH="LEFT" hidden="true">
          <Size><AbsDimension x="42" y="18"/></Size>
          <Anchors>
            <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="18" y="53"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtRecipePosition" inherits="GameFontDisableSmall" justifyH="RIGHT">
          <Size><AbsDimension x="70" y="18"/></Size>
          <Anchors>
            <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-18" y="52"/></Offset></Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>

    <Frames>
      <Button name="$parentCheapestMode" text="Cheapest now" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="112" y="24"/></Size>
        <Anchors>
          <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-40"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>setRecommendationMode("dynamic");</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentStaticMode" text="Static guide" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="96" y="24"/></Size>
        <Anchors>
          <Anchor point="TOPLEFT"><Offset><AbsDimension x="136" y="-40"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>setRecommendationMode("static");</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentRoute" text="Route" inherits="UIPanelButtonTemplate" hidden="true">
        <Size><AbsDimension x="68" y="24"/></Size>
        <Anchors>
          <Anchor point="TOPRIGHT"><Offset><AbsDimension x="-26" y="-40"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnEnter>showDynamicRouteTooltip(self);</OnEnter>
          <OnLeave>GameTooltip:Hide();</OnLeave>
        </Scripts>
      </Button>

      <Frame name="MainFrameCoreMaterials">
        <Size><AbsDimension x="356" y="224"/></Size>
        <Anchors>
          <Anchor point="TOPLEFT"><Offset><AbsDimension x="18" y="-312"/></Offset></Anchor>
        </Anchors>
      </Frame>

      <Button name="$parentClose" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT"><Offset><AbsDimension x="-5" y="-5"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>TogglePcapperFrame("hide");</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentRepeatMode" text="Until change" inherits="UIPanelButtonTemplate" hidden="true">
        <Size><AbsDimension x="108" y="22"/></Size>
        <Anchors>
          <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="60" y="49"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>toggleEnchantRepeatMode();</OnClick>
        </Scripts>
      </Button>

      <EditBox name="$parentRepeatCount" inherits="InputBoxTemplate" autoFocus="false" hidden="true">
        <Size><AbsDimension x="42" y="20"/></Size>
        <Anchors>
          <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="180" y="50"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>self:SetNumeric(true); self:SetMaxLetters(3); self:SetJustifyH("CENTER");</OnLoad>
          <OnTextChanged>enchantRepeatCountChanged(self);</OnTextChanged>
          <OnEnterPressed>enchantRepeatCountCommit(self);</OnEnterPressed>
          <OnEscapePressed>self:ClearFocus();</OnEscapePressed>
          <OnEditFocusLost>enchantRepeatCountCommit(self);</OnEditFocusLost>
        </Scripts>
      </EditBox>

      <Button name="$parentPreviousRecipe" text="&lt;" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="36" y="28"/></Size>
        <Anchors>
          <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="18" y="16"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>displayPreviousRecipe();</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentCraft" text="Craft" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="228" y="28"/></Size>
        <Anchors>
          <Anchor point="BOTTOM"><Offset><AbsDimension x="0" y="16"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>craftRecipe();</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentNextRecipe" text="&gt;" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="36" y="28"/></Size>
        <Anchors>
          <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-18" y="16"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>displayNextRecipe();</OnClick>
        </Scripts>
      </Button>
    </Frames>
  </Frame>
</Ui>
