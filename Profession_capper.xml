<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="Core.lua"/>
  <Frame name="MainFrameCore" parent="UIParent" hidden="true" movable="true" enableMouse="true" clampedToScreen="true">
    <Scripts>
      <OnLoad>fnOnLoad();</OnLoad>
      <OnEvent>fnOnEvent();</OnEvent>
      <OnDragStart>self:StartMoving();</OnDragStart>
      <OnDragStop>self:StopMovingOrSizing();</OnDragStop>
    </Scripts>

    <Anchors>
      <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMLEFT">
        <Offset><AbsDimension x="0" y="0"/></Offset>
      </Anchor>
    </Anchors>

    <Size><AbsDimension x="280" y="300"/></Size>

    <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" tile="true" edgeFile="Interface\DialogFrame\UI-DialogBox-Border">
      <TileSize><AbsValue val="32"/></TileSize>
      <EdgeSize><AbsValue val="32"/></EdgeSize>
      <BackgroundInsets><AbsInset left="11" right="12" top="12" bottom="11"/></BackgroundInsets>
    </Backdrop>

    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentTitle" file="Interface\DialogFrame\UI-DialogBox-Header">
          <Size><AbsDimension x="300" y="64"/></Size>
          <Anchors>
            <Anchor point="TOP"><Offset><AbsDimension x="0" y="0"/></Offset></Anchor>
          </Anchors>
        </Texture>

        <FontString name="txtHeaderLabel" inherits="GameFontNormal" text="Next recipe you should craft">
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentTitle"><Offset><AbsDimension x="0" y="-14"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtShouldCraft" inherits="GameFontNormal">
          <Size><AbsDimension x="240" y="24"/></Size>
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentTitle"><Offset><AbsDimension x="0" y="-50"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <Texture name="imgSkillIcon" file="Interface\InventoryItems\WoWUnknownItem01">
          <Size><AbsDimension x="44" y="44"/></Size>
          <Anchors>
            <Anchor point="TOP"><Offset><AbsDimension x="0" y="-78"/></Offset></Anchor>
          </Anchors>
        </Texture>

        <FontString name="txtCraftStats" inherits="GameFontHighlightSmall">
          <Size><AbsDimension x="250" y="34"/></Size>
          <Anchors>
            <Anchor point="TOP"><Offset><AbsDimension x="0" y="-128"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCraftEta" inherits="GameFontNormalSmall">
          <Size><AbsDimension x="250" y="18"/></Size>
          <Anchors>
            <Anchor point="TOP"><Offset><AbsDimension x="0" y="-160"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtShouldCraftRecipe" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size><AbsDimension x="240" y="62"/></Size>
          <Anchors>
            <Anchor point="TOP"><Offset><AbsDimension x="0" y="-218"/></Offset></Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>

    <Frames>
      <Button name="$parentCraft" text="Craft" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="112" y="28"/></Size>
        <Anchors>
          <Anchor point="TOP"><Offset><AbsDimension y="-182"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>self:RegisterForClicks("LeftButtonUp");</OnLoad>
          <OnClick>craftRecipe();</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentNextRecipe" text="&gt;" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="30" y="28"/></Size>
        <Anchors>
          <Anchor point="TOPRIGHT"><Offset><AbsDimension y="-182" x="-24"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>self:RegisterForClicks("LeftButtonUp");</OnLoad>
          <OnClick>displayNextRecipe();</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentPreviousRecipe" text="&lt;" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="30" y="28"/></Size>
        <Anchors>
          <Anchor point="TOPLEFT"><Offset><AbsDimension y="-182" x="24"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnLoad>self:RegisterForClicks("LeftButtonUp");</OnLoad>
          <OnClick>displayPreviousRecipe();</OnClick>
        </Scripts>
      </Button>
    </Frames>
  </Frame>
</Ui>
