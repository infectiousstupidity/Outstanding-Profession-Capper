<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
  <Script file="Core.lua"/>

  <Frame name="MainFrameCore" parent="UIParent" hidden="true" movable="true" enableMouse="true" clampedToScreen="true">
    <Scripts>
      <OnLoad>fnOnLoad(); self:SetBackdropColor(0.04, 0.04, 0.04, 0.96);</OnLoad>
      <OnEvent>fnOnEvent();</OnEvent>
      <OnDragStart>ProfessionCapper_OnDragStart();</OnDragStart>
      <OnDragStop>ProfessionCapper_OnDragStop();</OnDragStop>
    </Scripts>

    <Size><AbsDimension x="330" y="330"/></Size>

    <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
      <TileSize><AbsValue val="16"/></TileSize>
      <EdgeSize><AbsValue val="16"/></EdgeSize>
      <BackgroundInsets><AbsInset left="4" right="4" top="4" bottom="4"/></BackgroundInsets>
    </Backdrop>

    <Layers>
      <Layer level="ARTWORK">
        <FontString name="txtHeaderLabel" inherits="GameFontNormalLarge" justifyH="LEFT">
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="-14"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtProfessionProgress" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size><AbsDimension x="275" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="-39"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <Texture name="imgSkillIcon" file="Interface\InventoryItems\WoWUnknownItem01">
          <Size><AbsDimension x="42" y="42"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="-67"/></Offset></Anchor>
          </Anchors>
        </Texture>

        <FontString name="txtShouldCraft" inherits="GameFontNormal" justifyH="LEFT">
          <Size><AbsDimension x="238" y="22"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="70" y="-66"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtTarget" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size><AbsDimension x="238" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="70" y="-89"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCraftStats" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Size><AbsDimension x="298" y="34"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="-122"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCraftProgress" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size><AbsDimension x="298" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="-156"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtCraftEta" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size><AbsDimension x="298" y="18"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="-177"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtShouldCraftRecipe" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
          <Size><AbsDimension x="298" y="70"/></Size>
          <Anchors>
            <Anchor point="TOPLEFT"><Offset><AbsDimension x="16" y="-207"/></Offset></Anchor>
          </Anchors>
        </FontString>

        <FontString name="txtRecipePosition" inherits="GameFontDisableSmall">
          <Size><AbsDimension x="60" y="18"/></Size>
          <Anchors>
            <Anchor point="BOTTOM"><Offset><AbsDimension x="0" y="48"/></Offset></Anchor>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>

    <Frames>
      <Button name="$parentClose" inherits="UIPanelCloseButton">
        <Anchors>
          <Anchor point="TOPRIGHT"><Offset><AbsDimension x="-4" y="-4"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>TogglePcapperFrame("hide");</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentPreviousRecipe" text="&lt;" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="32" y="28"/></Size>
        <Anchors>
          <Anchor point="BOTTOMLEFT"><Offset><AbsDimension x="16" y="14"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>displayPreviousRecipe();</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentCraft" text="Craft" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="190" y="28"/></Size>
        <Anchors>
          <Anchor point="BOTTOM"><Offset><AbsDimension x="0" y="14"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>craftRecipe();</OnClick>
        </Scripts>
      </Button>

      <Button name="$parentNextRecipe" text="&gt;" inherits="UIPanelButtonTemplate">
        <Size><AbsDimension x="32" y="28"/></Size>
        <Anchors>
          <Anchor point="BOTTOMRIGHT"><Offset><AbsDimension x="-16" y="14"/></Offset></Anchor>
        </Anchors>
        <Scripts>
          <OnClick>displayNextRecipe();</OnClick>
        </Scripts>
      </Button>
    </Frames>
  </Frame>
</Ui>
